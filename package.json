{
  "name": "windy-card",
  "version": "1.16.1",
  "description": "A Lovelace card for Windy Map and Forecast.",
  "homepage": "https://github.com/timmaurice/lovelace-windy-card#readme",
  "bugs": {
    "url": "https://github.com/timmaurice/lovelace-windy-card/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/timmaurice/lovelace-windy-card.git"
  },
  "license": "MIT",
  "author": "Tim Maurice Bayer",
  "type": "module",
  "main": "dist/windy-card.js",
  "scripts": {
    "build": "rollup -c",
    "check-format": "prettier --check .",
    "format": "prettier . --write",
    "lint": "eslint .",
    "test": "NODE_ENV=production vitest run",
    "watch": "rollup -c -w",
    "pretest:e2e": "node scripts/ensure-deps.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.0",
    "lit": "^3.3.3",
    "prettier": "^3.9.10",
    "rollup": "^4.68.0",
    "rollup-plugin-lit-css": "^6.0.1",
    "sass": "^1.108.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "tslib": "^2.9.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "@parcel/watcher@2.6.0": true
  }
}
